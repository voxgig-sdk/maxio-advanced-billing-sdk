# BasicSubscriptionFlow

main: kit: flow: BasicSubscriptionFlow:
{
  entity: "subscription",
  kind: "basic",
  name: "BasicSubscriptionFlow",
  step: [
    {
      i: {
        ref: "subscription_ref01"
      }

      m: {
        customer_id: "customer01",
        subscription_id: "subscription01"
      }

      o: "create"
    }

    {
      m: {
        customer_id: "customer01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "subscription_ref01"
          }
        }
      ]
    }

    {
      d: {
        subscription_id: "subscription01"
      }

      i: {
        ref: "subscription_ref01",
        srcdatavar: "subscription_ref01_data",
        suffix: "_up0",
        textfield: "activated_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-subscription_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "subscription_ref01",
        srcdatavar: "subscription_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-subscription_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "subscription_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "subscription01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        customer_id: "customer01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "subscription_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSubscriptionFlow"
}