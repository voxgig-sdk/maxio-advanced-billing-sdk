# BasicInvoiceFlow

main: kit: flow: BasicInvoiceFlow:
{
  entity: "invoice",
  kind: "basic",
  name: "BasicInvoiceFlow",
  step: [
    {
      i: {
        ref: "invoice_ref01"
      }

      m: {
        subscription_id: "subscription01",
        uid: "uid01"
      }

      o: "create"
    }

    {
      m: {
        uid: "uid01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "invoice_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "invoice_ref01",
        srcdatavar: "invoice_ref01_data",
        suffix: "_up0",
        textfield: "applied_amount"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-invoice_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "invoice_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "invoice01",
        uid: "uid01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        uid: "uid01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "invoice_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicInvoiceFlow"
}