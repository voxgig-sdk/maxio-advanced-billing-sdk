# BasicProductFamilyFlow

main: kit: flow: BasicProductFamilyFlow:
{
  entity: "product_family",
  kind: "basic",
  name: "BasicProductFamilyFlow",
  step: [
    {
      i: {
        ref: "product_family_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "product_family_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "product_family_ref01",
        srcdatavar: "product_family_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "product_family01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-product_family_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProductFamilyFlow"
}