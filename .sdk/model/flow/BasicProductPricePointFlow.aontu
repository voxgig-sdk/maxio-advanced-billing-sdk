# BasicProductPricePointFlow

main: kit: flow: BasicProductPricePointFlow:
{
  entity: "product_price_point",
  kind: "basic",
  name: "BasicProductPricePointFlow",
  step: [
    {
      i: {
        ref: "product_price_point_ref01"
      }

      m: {
        price_point_id: "price_point01",
        product_id: "product01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "product_price_point_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "product_price_point_ref01",
        srcdatavar: "product_price_point_ref01_data",
        suffix: "_up0",
        textfield: "accounting_code"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-product_price_point_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "product_price_point_ref01",
        srcdatavar: "product_price_point_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "product_price_point01",
        price_point_id: "price_point01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-product_price_point_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "product_price_point_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "product_price_point01",
        price_point_id: "price_point01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "product_price_point_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProductPricePointFlow"
}