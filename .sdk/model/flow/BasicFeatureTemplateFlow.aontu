# BasicFeatureTemplateFlow

main: kit: flow: BasicFeatureTemplateFlow:
{
  entity: "feature_template",
  kind: "basic",
  name: "BasicFeatureTemplateFlow",
  step: [
    {
      i: {
        ref: "feature_template_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "feature_template_ref01",
        srcdatavar: "feature_template_ref01_data",
        suffix: "_up0",
        textfield: "archived_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-feature_template_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "feature_template_ref01",
        srcdatavar: "feature_template_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "feature_template01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-feature_template_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "feature_template_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "feature_template01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicFeatureTemplateFlow"
}