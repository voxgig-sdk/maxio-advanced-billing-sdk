# BasicSegmentFlow

main: kit: flow: BasicSegmentFlow:
{
  entity: "segment",
  kind: "basic",
  name: "BasicSegmentFlow",
  step: [
    {
      i: {
        ref: "segment_ref01"
      }

      m: {
        component_id: "component01",
        price_point_id: "price_point01"
      }

      o: "create"
    }

    {
      d: {
        component_id: "component01"
      }

      i: {
        ref: "segment_ref01",
        srcdatavar: "segment_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-segment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSegmentFlow"
}