    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /invoices.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "consolidation_level"
                or: "consolidation_level"
                r: false
                t: "`$STRING`"
              }
              {
                ex: false
                k: "query"
                n: "credit"
                or: "credit"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                ex: false
                k: "query"
                n: "custom_field"
                or: "custom_field"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                ex: [
                  1
                  2
                  3
                ]
                k: "query"
                n: "customer_id"
                or: "customer_id"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "date_field"
                or: "date_field"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "direction"
