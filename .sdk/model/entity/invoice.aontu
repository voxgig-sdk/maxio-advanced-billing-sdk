      t: "`$ARRAY`"
    }
    applied_amount: {
      h: "Applied Amount"
      n: "applied_amount"
      r: false
      sh: "The amount of the credit note that has already been applied to invoices."
      t: "`$STRING`"
    }
    applied_date: {
      fo: "date"
      h: "Applied Date"
      n: "applied_date"
      r: false
      sh: "Credit notes are applied to invoices to offset invoiced amounts - they reduce the amount due."
      t: "`$STRING`"
    }
    avatax_details: {
      h: "Avatax Details"
      n: "avatax_details"
      r: false
      t: "`$OBJECT`"
    }
