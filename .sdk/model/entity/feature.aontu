# Entity: feature

main: kit: entity: feature: {

  alias: field: {}

  fields: {
    archived_at: {
      fo: "date-time"
      h: "Archived At"
      n: "archived_at"
      r: false
      sh: "The date and time the feature template was archived, or `null` if it is active."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      t: "`$STRING`"
    }
    default_periodicity_interval: {
      fo: "int32"
      h: "Default Periodicity Interval"
      n: "default_periodicity_interval"
      r: false
      sh: "For `usage_limit` features, the default periodicity interval used to pre-populate new feature catalog items."
      t: "`$INTEGER`"
    }
    default_periodicity_unit: {
      h: "Default Periodicity Unit"
      n: "default_periodicity_unit"
      r: false
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    default_value: {
      h: "Default Value"
      n: "default_value"
      r: false
      sh: "A default value used to pre-populate new feature catalog items created from this template."
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      t: "`$STRING`"
    }
    feature: {
      h: "Feature"
      n: "feature"
      op: {
        create: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 2
        depth: 4
      }
    }
    feature_key: {
      h: "Feature Key"
      n: "feature_key"
      r: false
      sh: "The `key` of the parent feature template."
      t: "`$STRING`"
    }
    feature_kind: {
      h: "Feature Kind"
      n: "feature_kind"
      r: false
      t: "`$ANY`"
    }
    feature_name: {
      h: "Feature Name"
      n: "feature_name"
      r: false
      sh: "The `name` of the parent feature template."
      t: "`$STRING`"
    }
    feature_template_id: {
      fo: "int32"
      h: "Feature Template Id"
      n: "feature_template_id"
      r: false
      sh: "The id of the feature template this item was created from."
      t: "`$INTEGER`"
    }
    id: {
      fo: "int32"
      h: "Id"
      n: "id"
      r: false
      sh: "The Advanced Billing id of the feature template."
      t: "`$INTEGER`"
    }
    key: {
      h: "Key"
      n: "key"
      r: false
      sh: "A unique, lowercase, underscore-separated identifier for the feature."
      t: "`$STRING`"
    }
    kind: {
      h: "Kind"
      n: "kind"
      r: false
      t: "`$ANY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The display name of the feature."
      t: "`$STRING`"
    }
    periodicity_interval: {
      fo: "int32"
      h: "Periodicity Interval"
      n: "periodicity_interval"
      r: false
      sh: "Set when `feature_kind` is `usage_limit`; `null` otherwise."
      t: "`$INTEGER`"
    }
    periodicity_unit: {
      h: "Periodicity Unit"
      n: "periodicity_unit"
      r: false
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    plans_count: {
      fo: "int32"
      h: "Plans Count"
      n: "plans_count"
      r: false
      sh: "The number of **products** this feature template is currently attached to via an active feature catalog item."
      t: "`$INTEGER`"
    }
    price_point_id: {
      fo: "int32"
      h: "Price Point Id"
      n: "price_point_id"
      r: false
      sh: "Set together with `price_point_type` for price-point-specific overrides."
      t: "`$INTEGER`"
    }
    price_point_type: {
      h: "Price Point Type"
      n: "price_point_type"
      r: false
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    products_count: {
      fo: "int32"
      h: "Products Count"
      n: "products_count"
      r: false
      sh: "The number of **components** this feature template is currently attached to via an active feature catalog item."
      t: "`$INTEGER`"
    }
    unit: {
      h: "Unit"
      n: "unit"
      r: false
      sh: "The unit the feature is measured in (for example, `requests` or `GB`)."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      t: "`$STRING`"
    }
    value: {
      h: "Value"
      n: "value"
      r: false
      sh: "The value granted by this feature catalog item."
      t: "`$STRING`"
    }
    value_type: {
      h: "Value Type"
      n: "value_type"
      r: false
      t: "`$ANY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "feature"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /components/{component_id}/features.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "component_id"
                or: "component_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/components/{component_id}/features.json"
          q: {
            exist: [
              "component_id"
            ]
          }
          s: [
            {
              lit: "components"
            }
            {
              var: "component_id"
            }
            {
              lit: "features.json"
            }
          ]
          t: {
            req: {
              feature: "`reqdata`"
            }
            res: "`body.feature`"
          }
        }
        {
          co: {
            id: "POST /products/{product_id}/features.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "product_id"
                or: "product_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/products/{product_id}/features.json"
          q: {
            exist: [
              "product_id"
            ]
          }
          s: [
            {
              lit: "products"
            }
            {
              var: "product_id"
            }
            {
              lit: "features.json"
            }
          ]
          t: {
            req: {
              feature: "`reqdata`"
            }
            res: "`body.feature`"
          }
        }
        {
          co: {
            id: "POST /features.json"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/features.json"
          s: [
            {
              lit: "features.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.feature`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /features.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "kind"
                or: "kind"
                r: false
                t: "`$ANY`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 50
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "sort_by"
                or: "sort_by"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "sort_direction"
                or: "sort_direction"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "status"
                or: "status"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "updated_from"
                or: "updated_from"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "updated_to"
                or: "updated_to"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/features.json"
          q: {
            exist: [
              "kind"
              "page"
              "per_page"
              "q"
              "sort_by"
              "sort_direction"
              "status"
              "updated_from"
              "updated_to"
            ]
          }
          s: [
            {
              lit: "features.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
        {
          co: {
            id: "GET /components/{component_id}/features.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "component_id"
                or: "component_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/components/{component_id}/features.json"
          q: {
            exist: [
              "component_id"
            ]
          }
          s: [
            {
              lit: "components"
            }
            {
