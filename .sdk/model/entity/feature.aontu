        {
          co: {
            id: "GET /products/{product_id}/features.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "product_id"
                or: "product_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/products/{product_id}/features.json"
          q: {
            exist: [
              "product_id"
            ]
          }
          s: [
            {
              lit: "products"
            }
            {
              var: "product_id"
            }
            {
              lit: "features.json"
