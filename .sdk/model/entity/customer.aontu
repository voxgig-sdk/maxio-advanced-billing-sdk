# Entity: customer

main: kit: entity: customer: {

  alias: field: {}

  fields: {
    address: {
      h: "Address"
      n: "address"
      r: false
      sh: "The customer’s shipping street address (e.g., “123 Main St.”)"
      t: "`$STRING`"
    }
    address_2: {
      h: "Address 2"
      n: "address_2"
      r: false
      sh: "Second line of the customer’s shipping address e.g., “Apt."
      t: "`$STRING`"
    }
    branding_theme_id: {
      fo: "int32"
      h: "Branding Theme Id"
      n: "branding_theme_id"
      r: false
      sh: "The ID of the Branding Theme assigned to this customer as the customer's default Branding Theme."
      t: "`$INTEGER`"
    }
    cc_emails: {
      h: "Cc Emails"
      n: "cc_emails"
      r: false
      sh: "“A comma-separated list of emails that should be cc’d on all customer communications (e.g., “joe@example.com, sue@example.com”)”"
      t: "`$STRING`"
    }
    city: {
      h: "City"
      n: "city"
      r: false
      sh: "The customer’s shipping address city (e.g., “Boston”)"
      t: "`$STRING`"
    }
    country: {
      h: "Country"
      n: "country"
      r: false
      sh: "The customer shipping address country"
      t: "`$STRING`"
    }
    country_name: {
      h: "Country Name"
      n: "country_name"
      r: false
      sh: "The customer's full name of country"
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      sh: "The timestamp in which the customer object was created in Chargify"
      t: "`$STRING`"
    }
    customer: {
      h: "Customer"
      n: "customer"
      r: true
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 4
      }
    }
    default_auto_renewal_profile_id: {
      fo: "int32"
      h: "Default Auto Renewal Profile Id"
      n: "default_auto_renewal_profile_id"
      r: false
      sh: "The default auto-renewal profile ID for the customer"
      t: "`$INTEGER`"
    }
    default_subscription_group_uid: {
      h: "Default Subscription Group Uid"
      n: "default_subscription_group_uid"
      r: false
      t: "`$STRING`"
    }
    email: {
      h: "Email"
      n: "email"
      r: false
      sh: "The email address of the customer"
      t: "`$STRING`"
    }
    entity_identifier_kind: {
      h: "Entity Identifier Kind"
      n: "entity_identifier_kind"
      r: false
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    entity_identifier_value: {
      h: "Entity Identifier Value"
      n: "entity_identifier_value"
      r: false
      sh: "The value of the customer's tax or business identifier."
      t: "`$STRING`"
    }
    first_name: {
      h: "First Name"
      n: "first_name"
      r: false
      sh: "The first name of the customer"
      t: "`$STRING`"
    }
    id: {
      fo: "int32"
      h: "Id"
      n: "id"
      r: false
      sh: "The customer ID in Chargify"
      t: "`$INTEGER`"
    }
    last_name: {
      h: "Last Name"
      n: "last_name"
      r: false
      sh: "The last name of the customer"
      t: "`$STRING`"
    }
    locale: {
      h: "Locale"
      n: "locale"
      r: false
      sh: "The locale for the customer to identify language-region"
      t: "`$STRING`"
    }
    maxioid: {
      h: "Maxioid"
      n: "maxioid"
      r: false
      sh: "The Maxio-generated unique identifier for the customer."
      t: "`$STRING`"
    }
    organization: {
      h: "Organization"
      n: "organization"
      r: false
      sh: "The organization of the customer."
      t: "`$STRING`"
    }
    parent_id: {
      fo: "int32"
      h: "Parent Id"
      n: "parent_id"
      r: false
      sh: "The parent ID in Chargify if applicable."
      t: "`$INTEGER`"
    }
    phone: {
      h: "Phone"
      n: "phone"
      r: false
      sh: "The phone number of the customer"
      t: "`$STRING`"
    }
    portal_customer_created_at: {
      fo: "date-time"
      h: "Portal Customer Created At"
      n: "portal_customer_created_at"
      r: false
      sh: "The timestamp of when the Billing Portal entry was created at for the customer"
      t: "`$STRING`"
    }
    portal_invite_last_accepted_at: {
      fo: "date-time"
      h: "Portal Invite Last Accepted At"
      n: "portal_invite_last_accepted_at"
      r: false
      sh: "The timestamp of when the Billing Portal invite was last accepted"
      t: "`$STRING`"
    }
    portal_invite_last_sent_at: {
      fo: "date-time"
      h: "Portal Invite Last Sent At"
      n: "portal_invite_last_sent_at"
      r: false
      sh: "The timestamp of when the Billing Portal invite was last sent at"
      t: "`$STRING`"
    }
    reference: {
      h: "Reference"
      n: "reference"
      r: false
      sh: "The unique identifier used within your own application for this customer"
      t: "`$STRING`"
    }
    salesforce_id: {
      h: "Salesforce Id"
      n: "salesforce_id"
      r: false
      sh: "The Salesforce ID for the customer"
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
      sh: "The customer’s shipping address state (e.g., “MA”)"
      t: "`$STRING`"
    }
    state_name: {
      h: "State Name"
      n: "state_name"
      r: false
      sh: "The customer's full name of state"
      t: "`$STRING`"
    }
    surcharging: {
      h: "Surcharging"
      n: "surcharging"
      r: false
      sh: "Whether surcharging is enabled for the customer."
      t: "`$BOOLEAN`"
    }
    tax_exempt: {
      h: "Tax Exempt"
      n: "tax_exempt"
      r: false
      sh: "The tax exempt status for the customer."
      t: "`$BOOLEAN`"
    }
    tax_exempt_reason: {
      h: "Tax Exempt Reason"
      n: "tax_exempt_reason"
      r: false
      sh: "The Tax Exemption Reason Code for the customer"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "The timestamp in which the customer object was last edited"
      t: "`$STRING`"
    }
    vat_country: {
      h: "Vat Country"
      n: "vat_country"
      r: false
      sh: "The two-letter ISO 3166-1 country code that qualifies the customer's VAT number."
      t: "`$STRING`"
    }
    vat_number: {
      h: "Vat Number"
      n: "vat_number"
      r: false
      sh: "The VAT business identification number for the customer."
      t: "`$STRING`"
    }
    verified: {
      h: "Verified"
      n: "verified"
      r: false
      sh: "Is the customer verified to use ACH as a payment method."
      t: "`$BOOLEAN`"
    }
    zip: {
      h: "Zip"
      n: "zip"
      r: false
      sh: "The customer’s shipping address zip code (e.g., “12345”)"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "customer"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /portal/customers/{customer_id}/enable.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "customer_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
            query: [
              {
                k: "query"
                n: "auto_invite"
                or: "auto_invite"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          m: "POST"
          o: "/portal/customers/{customer_id}/enable.json"
          q: {
            "$action": "enable"
            exist: [
              "auto_invite"
              "id"
            ]
          }
          r: {
            param: {
              customer_id: "id"
            }
          }
          s: [
            {
              lit: "portal"
            }
            {
              lit: "customers"
            }
            {
              var: "id"
            }
            {
              lit: "enable.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.customer`"
          }
        }
        {
          co: {
            id: "POST /customers.json"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/customers.json"
          s: [
            {
              lit: "customers.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.customer`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /customers.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "date_field"
                or: "date_field"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "direction"
                or: "direction"
                r: false
                t: "`$ANY`"
              }
              {
                k: "query"
                n: "end_date"
                or: "end_date"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "end_datetime"
                or: "end_datetime"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "start_date"
                or: "start_date"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "start_datetime"
                or: "start_datetime"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/customers.json"
          q: {
            exist: [
              "date_field"
              "direction"
              "end_date"
              "end_datetime"
              "page"
              "per_page"
              "q"
              "start_date"
              "start_datetime"
            ]
          }
          s: [
            {
              lit: "customers.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /customers/{id}.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/customers/{id}.json"
          q: {
            "$action": "id"
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "customers"
            }
            {
              lit: "{id}.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.customer`"
          }
        }
        {
          co: {
            id: "GET /customers/lookup.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "reference"
                or: "reference"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/customers/lookup.json"
          q: {
            "$action": "lookup"
            exist: [
              "reference"
            ]
          }
          s: [
            {
              lit: "customers"
            }
            {
              lit: "lookup.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.customer`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /customers/{id}.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "DELETE"
          o: "/customers/{id}.json"
          q: {
            "$action": "id"
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "customers"
            }
            {
              lit: "{id}.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PUT /customers/{id}.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "PUT"
          o: "/customers/{id}.json"
          q: {
            "$action": "id"
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "customers"
            }
            {
              lit: "{id}.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.customer`"
          }
        }
      ]
    }
  }



}
