# Entity: component

main: kit: entity: component: {

  alias: field: {}

  fields: {
    accounting_code: {
      h: "Accounting Code"
      n: "accounting_code"
      r: false
      sh: "E.g."
      t: "`$STRING`"
    }
    allow_fractional_quantities: {
      h: "Allow Fractional Quantities"
      n: "allow_fractional_quantities"
      r: false
      t: "`$BOOLEAN`"
    }
    archived: {
      h: "Archived"
      n: "archived"
      r: false
      sh: "Boolean flag describing whether a component is archived or not."
      t: "`$BOOLEAN`"
    }
    archived_at: {
      fo: "date-time"
      h: "Archived At"
      n: "archived_at"
      r: false
      sh: "Timestamp indicating when this component was archived"
      t: "`$STRING`"
    }
    component: {
      h: "Component"
      n: "component"
      op: {
        list: {
          req: true
          type: "`$OBJECT`"
        }
      }
      r: false
      t: "`$OBJECT`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      sh: "Timestamp indicating when this component was created"
      t: "`$STRING`"
    }
    default_price_point_id: {
      fo: "int32"
      h: "Default Price Point Id"
      n: "default_price_point_id"
      r: false
      t: "`$INTEGER`"
    }
    default_price_point_name: {
      h: "Default Price Point Name"
      n: "default_price_point_name"
      r: false
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "The description of the component."
      t: "`$STRING`"
    }
    downgrade_credit: {
      h: "Downgrade Credit"
      n: "downgrade_credit"
      r: false
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    event_based_billing_metric_id: {
      fo: "int32"
      h: "Event Based Billing Metric Id"
      n: "event_based_billing_metric_id"
      r: false
      sh: "(Only for Event Based Components) This is an ID of a metric attached to the component."
      t: "`$INTEGER`"
    }
    features: {
      h: "Features"
      n: "features"
      r: false
      sh: "The active feature catalog items attached to this component."
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 2
        depth: 5
      }
    }
    handle: {
      h: "Handle"
      n: "handle"
      r: false
      sh: "The component API handle"
      t: "`$STRING`"
    }
    hide_date_range_on_invoice: {
      h: "Hide Date Range On Invoice"
      n: "hide_date_range_on_invoice"
      r: false
      sh: "(Only available on Relationship Invoicing sites) Boolean flag describing if the service date range should show for the component on generated invoices."
      t: "`$BOOLEAN`"
    }
    id: {
      fo: "int32"
      h: "Id"
      n: "id"
      r: false
      sh: "The unique ID assigned to the component by Chargify."
      t: "`$INTEGER`"
    }
    interval: {
      fo: "int32"
      h: "Interval"
      n: "interval"
      r: false
      sh: "The numerical interval."
      t: "`$INTEGER`"
    }
    interval_unit: {
      h: "Interval Unit"
      n: "interval_unit"
      r: false
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    item_category: {
      h: "Item Category"
      n: "item_category"
      r: false
      t: "`$ANY`"
