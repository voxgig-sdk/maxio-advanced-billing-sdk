        branches: 2
        count: 1
        depth: 2
      }
    }
    kind: {
      h: "Kind"
      n: "kind"
      r: false
      t: "`$ANY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the Component, suitable for display on statements."
      t: "`$STRING`"
    }
    overage_prices: {
      h: "Overage Prices"
      n: "overage_prices"
      r: false
      sh: "Applicable only to prepaid usage components."
      t: "`$ARRAY`"
    }
    price_per_unit_in_cents: {
      fo: "int64"
      h: "Price Per Unit In Cents"
      n: "price_per_unit_in_cents"
      r: false
      sh: "deprecated - use unit_price instead."
      t: "`$INTEGER`"
    }
    price_point_count: {
      fo: "int32"
      h: "Price Point Count"
      n: "price_point_count"
      r: false
      sh: "Count for the number of price points associated with the component"
      t: "`$INTEGER`"
    }
    price_points_url: {
      h: "Price Points Url"
      n: "price_points_url"
      r: false
      sh: "URL that points to the location to read the existing price points via GET request"
      t: "`$STRING`"
    }
    prices: {
      h: "Prices"
      n: "prices"
      r: false
      sh: "An array of price brackets."
      t: "`$ARRAY`"
    }
    pricing_scheme: {
      h: "Pricing Scheme"
      n: "pricing_scheme"
      r: false
      t: "`$ANY`"
