    recurring: {
      h: "Recurring"
      n: "recurring"
      r: false
      t: "`$BOOLEAN`"
    }
    tax_code: {
      h: "Tax Code"
      n: "tax_code"
      r: false
      sh: "A string representing the tax code related to the component type."
      t: "`$STRING`"
    }
    taxable: {
      h: "Taxable"
      n: "taxable"
      r: false
      sh: "Boolean flag describing whether a component is taxable or not."
