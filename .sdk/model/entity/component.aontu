    }
    unit_price: {
      h: "Unit Price"
      n: "unit_price"
      r: false
      sh: "The amount the customer will be charged per unit."
      t: "`$STRING`"
    }
    unspsc_code: {
      h: "Unspsc Code"
      n: "unspsc_code"
