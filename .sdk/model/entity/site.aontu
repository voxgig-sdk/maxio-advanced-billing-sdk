# Entity: site

main: kit: entity: site: {

  alias: field: {}

  fields: {
    allocation_settings: {
      h: "Allocation Settings"
      n: "allocation_settings"
      r: false
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 2
        depth: 4
      }
    }
    auto_renewals_enabled: {
      h: "Auto Renewals Enabled"
      n: "auto_renewals_enabled"
      r: false
      sh: "Whether the auto-renewals feature is enabled for this site."
      t: "`$BOOLEAN`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      t: "`$STRING`"
    }
    currency: {
      h: "Currency"
      n: "currency"
      r: false
      t: "`$STRING`"
    }
    customer_hierarchy_enabled: {
      h: "Customer Hierarchy Enabled"
      n: "customer_hierarchy_enabled"
      r: false
      t: "`$BOOLEAN`"
    }
    default_payment_collection_method: {
      h: "Default Payment Collection Method"
      n: "default_payment_collection_method"
      r: false
      t: "`$STRING`"
    }
    id: {
      fo: "int32"
      h: "Id"
      n: "id"
      r: false
      t: "`$INTEGER`"
    }
    multi_frequency_enabled: {
      h: "Multi Frequency Enabled"
      n: "multi_frequency_enabled"
      r: false
      sh: "Whether the site has the multi-frequency billing feature enabled."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      t: "`$STRING`"
    }
    net_terms: {
      h: "Net Terms"
      n: "net_terms"
      r: false
      t: "`$OBJECT`"
    }
    non_primary_currencies: {
      h: "Non Primary Currencies"
      n: "non_primary_currencies"
      r: false
      t: "`$ARRAY`"
    }
    organization_address: {
      h: "Organization Address"
      n: "organization_address"
      r: false
      t: "`$OBJECT`"
    }
    portal_enabled: {
      h: "Portal Enabled"
      n: "portal_enabled"
      r: false
      sh: "Whether the Billing Portal is enabled for this site."
      t: "`$BOOLEAN`"
    }
    public_key: {
      h: "Public Key"
      n: "public_key"
      r: false
      t: "`$STRING`"
    }
    relationship_invoicing_enabled: {
      h: "Relationship Invoicing Enabled"
      n: "relationship_invoicing_enabled"
      r: false
      t: "`$BOOLEAN`"
    }
    requires_security_token: {
      h: "Requires Security Token"
      n: "requires_security_token"
      r: false
      t: "`$BOOLEAN`"
    }
    schedule_subscription_cancellation_enabled: {
      h: "Schedule Subscription Cancellation Enabled"
      n: "schedule_subscription_cancellation_enabled"
      r: false
      t: "`$BOOLEAN`"
    }
    seller_id: {
      fo: "int32"
      h: "Seller Id"
      n: "seller_id"
      r: false
      t: "`$INTEGER`"
    }
    subdomain: {
      h: "Subdomain"
      n: "subdomain"
      r: false
      t: "`$STRING`"
    }
    tax_configuration: {
      h: "Tax Configuration"
      n: "tax_configuration"
      r: false
      t: "`$OBJECT`"
    }
    test: {
      h: "Test"
      n: "test"
      r: false
      t: "`$BOOLEAN`"
    }
    whopays_default_payer: {
      h: "Whopays Default Payer"
      n: "whopays_default_payer"
      r: false
      t: "`$STRING`"
    }
    whopays_enabled: {
      h: "Whopays Enabled"
      n: "whopays_enabled"
      r: false
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "site"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /sites/clear_data.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "cleanup_scope"
                or: "cleanup_scope"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          m: "POST"
          o: "/sites/clear_data.json"
          q: {
            "$action": "clear_data"
            exist: [
              "cleanup_scope"
            ]
          }
          s: [
            {
              lit: "sites"
            }
            {
              lit: "clear_data.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /chargify_js_keys.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 50
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/chargify_js_keys.json"
          q: {
            exist: [
              "page"
              "per_page"
            ]
          }
          s: [
            {
              lit: "chargify_js_keys.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.chargify_js_keys`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /site.json"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/site.json"
          s: [
            {
              lit: "site.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.site`"
          }
        }
      ]
    }
  }



}
