# Entity: subscription_product

main: kit: entity: subscription_product: {

  alias: field: {}

  fields: {
    charge_in_cents: {
      fo: "int64"
      h: "Charge In Cents"
      n: "charge_in_cents"
      r: false
      sh: "The amount of the charge that would be created for the new product."
      t: "`$INTEGER`"
    }
    credit_applied_in_cents: {
      fo: "int64"
      h: "Credit Applied In Cents"
      n: "credit_applied_in_cents"
      r: false
      sh: "Represents a credit in cents that is applied to your subscription as part of a migration process for a specific product, which reduces the amount owed for the subscription."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    migration: {
      h: "Migration"
      n: "migration"
      r: true
      t: "`$OBJECT`"
    }
    payment_due_in_cents: {
      fo: "int64"
      h: "Payment Due In Cents"
      n: "payment_due_in_cents"
      r: false
      sh: "The amount of the payment due in the case of an upgrade."
      t: "`$INTEGER`"
    }
    prorated_adjustment_in_cents: {
      fo: "int64"
      h: "Prorated Adjustment In Cents"
      n: "prorated_adjustment_in_cents"
      r: false
      sh: "The amount of the prorated adjustment that would be issued for the current subscription."
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "subscription_product"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /subscriptions/{subscription_id}/migrations.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "subscription_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/subscriptions/{subscription_id}/migrations.json"
          q: {
            "$action": "migrations.json"
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              subscription_id: "id"
            }
          }
          s: [
            {
              lit: "subscriptions"
            }
            {
              var: "id"
            }
            {
              lit: "migrations.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.subscription`"
          }
        }
        {
          co: {
            id: "POST /subscriptions/{subscription_id}/migrations/preview.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "subscription_id"
                or: "subscription_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/subscriptions/{subscription_id}/migrations/preview.json"
          q: {
            exist: [
              "subscription_id"
            ]
          }
          s: [
            {
              lit: "subscriptions"
            }
            {
              var: "subscription_id"
            }
            {
              lit: "migrations"
            }
            {
              lit: "preview.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.migration`"
          }
        }
      ]
