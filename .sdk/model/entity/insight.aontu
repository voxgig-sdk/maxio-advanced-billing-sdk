# Entity: insight

main: kit: entity: insight: {

  alias: field: {}

  fields: {
    amount_formatted: {
      h: "Amount Formatted"
      n: "amount_formatted"
      r: false
      t: "`$STRING`"
    }
    amount_in_cents: {
      fo: "int64"
      h: "Amount In Cents"
      n: "amount_in_cents"
      r: false
      t: "`$INTEGER`"
    }
    at_time: {
      fo: "date-time"
      h: "At Time"
      n: "at_time"
      r: false
      sh: "ISO8601 timestamp"
      t: "`$STRING`"
    }
    breakouts: {
      h: "Breakouts"
      n: "breakouts"
      r: false
      t: "`$OBJECT`"
    }
    currency: {
      h: "Currency"
      n: "currency"
      r: false
      t: "`$STRING`"
    }
    currency_symbol: {
      h: "Currency Symbol"
      n: "currency_symbol"
      r: false
      t: "`$STRING`"
    }
    movements: {
      h: "Movements"
      n: "movements"
      r: false
      t: "`$ARRAY`"
    }
    page: {
      fo: "int32"
      h: "Page"
      n: "page"
      r: false
      t: "`$INTEGER`"
    }
    per_page: {
      fo: "int32"
      h: "Per Page"
      n: "per_page"
      r: false
      t: "`$INTEGER`"
    }
    seller_name: {
      h: "Seller Name"
      n: "seller_name"
      r: false
      t: "`$STRING`"
    }
    site_currency: {
      h: "Site Currency"
      n: "site_currency"
      r: false
      t: "`$STRING`"
    }
    site_id: {
      fo: "int32"
      h: "Site Id"
      n: "site_id"
      r: false
      t: "`$INTEGER`"
    }
    site_name: {
      h: "Site Name"
      n: "site_name"
      r: false
      t: "`$STRING`"
    }
    stats: {
      h: "Stats"
      n: "stats"
      r: false
      t: "`$OBJECT`"
    }
    total_entries: {
      fo: "int32"
      h: "Total Entries"
      n: "total_entries"
      r: false
      t: "`$INTEGER`"
    }
    total_pages: {
      fo: "int32"
      h: "Total Pages"
      n: "total_pages"
      r: false
      t: "`$INTEGER`"
    }
  }

  name: "insight"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /mrr_movements.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "direction"
                or: "direction"
                r: false
                t: "`$ANY`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 20
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "subscription_id"
                or: "subscription_id"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/mrr_movements.json"
          q: {
            exist: [
              "direction"
              "page"
              "per_page"
              "subscription_id"
            ]
          }
          s: [
            {
              lit: "mrr_movements.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.mrr`"
          }
        }
        {
          co: {
            id: "GET /mrr.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "at_time"
                or: "at_time"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "subscription_id"
                or: "subscription_id"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/mrr.json"
          q: {
            exist: [
              "at_time"
              "subscription_id"
            ]
          }
          s: [
            {
              lit: "mrr.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.mrr`"
          }
        }
        {
          co: {
            id: "GET /stats.json"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/stats.json"
          s: [
            {
              lit: "stats.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
